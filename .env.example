# Copiar a .env y completar los valores.
# firebase.key.json (credenciales de Firebase Admin) NO va como variable:
# se sube como Secret File en Render, en la raíz del proyecto.

PORT=
DB=
DB_URI=
APPLICATION=
EMAIL=
KEY_MAIL=
# Orígenes permitidos por CORS, separados por comas.
# Default si no se define: http://localhost:5173,https://nicolas-sanetti-front.vercel.app
CORS_ORIGINS=
NODE_ENV=

# Sanity (contenido del panel /admin). Si falta alguna, el server no arranca.
# Valores: project 6j2h7mq3, dataset production, apiVersion 2025-02-19.
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_API_VERSION=
# Token con rol Editor (manage.sanity.io → API → Tokens). Secreto: solo en .env y en Render.
SANITY_WRITE_TOKEN=
